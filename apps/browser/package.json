{
  "name": "@proa/browser",
  "version": "0.1.0",
  "description": "Proa desktop app — the agent-native browser (Electron shell over the @proa/* core).",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "electron-vite build && electron-builder --mac --dir",
    "dist": "electron-vite build && electron-builder --mac",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@proa/core": "workspace:*",
    "@proa/extractor": "workspace:*",
    "@proa/permissions": "workspace:*",
    "@proa/protocol": "workspace:*",
    "@proa/traces": "workspace:*",
    "@proa/mcp": "workspace:*"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.1.2",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
