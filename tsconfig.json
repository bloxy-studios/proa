{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "benchmark/src/**/*.ts",
    "benchmark/test/**/*.ts",
    "fixtures/*/src/**/*.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**", "apps/**"]
}
